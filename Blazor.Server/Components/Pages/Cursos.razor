    private static async Task<string> LeerErrorApiAsync(HttpResponseMessage response)
    {
        try
        {
            var json = await response.Content.ReadFromJsonAsync<System.Text.Json.Nodes.JsonObject>();
            if (json != null && json.TryGetPropertyValue("error", out var errorNode))
            {
                return errorNode?.ToString() ?? "Error en la operación.";
            }
        }
        catch
        {
        }
        var texto = await response.Content.ReadAsStringAsync();
        return string.IsNullOrWhiteSpace(texto) ? response.ReasonPhrase ?? "Error en la operación." : texto;
    }

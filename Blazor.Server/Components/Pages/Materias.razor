@page "/materias"
@inject APISession Session
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Materias - TPI Academia</PageTitle>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0">Catálogo de Materias</h3>
            <span class="text-muted small">
                Consulta, edición de carga horaria y bajas. El alta de nuevas materias se gestiona desde el Plan de Estudio.
            </span>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @mensajeExito
            <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @mensajeError
            <button type="button" class="btn-close" @onclick="() => mensajeError = null"></button>
        </div>
    }

    <!-- Búsqueda -->
    <div class="card mb-3 shadow-sm border-0">
        <div class="card-body py-2">
            <div class="row g-2 align-items-center">
                <div class="col-md-6 col-lg-4">
                    <input type="text" class="form-control" placeholder="Buscar por descripción de materia..."
                           @bind="textoBusqueda" @bind:event="oninput" @onkeydown="ManejarTeclaBusqueda" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-outline-secondary" @onclick="BuscarAsync">Buscar</button>
                    <button class="btn btn-link text-decoration-none" @onclick="MostrarTodosAsync">Mostrar todas</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Grilla -->
    @if (cargando)
    {
        <p class="text-muted py-3">Cargando materias...</p>
    }
    else if (materias == null || !materias.Any())
    {
        <div class="alert alert-warning">
            No se encontraron materias registradas.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm">
            <table class="table table-striped table-hover table-bordered align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th style="width: 70px;">Id</th>
                        <th>Descripción</th>
                        <th style="width: 140px;" class="text-center">Hs Semanales</th>
                        <th style="width: 140px;" class="text-center">Hs Totales</th>
                        <th>Plan de Estudio</th>
                        <th style="width: 170px;" class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in materias)
                    {
                        <tr>
                            <td>@m.Id</td>
                            <td><strong>@m.Descripcion</strong></td>
                            <td class="text-center">@m.HsSemanales hs</td>
                            <td class="text-center">@m.HsTotales hs</td>
                            <td>@ObtenerNombrePlan(m.IdPlan)</td>
                            <td class="text-center">
                                @if (Session.TienePermiso("Materias", "Modificar"))
                                {
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => AbrirModalModificar(m)">
                                        Editar
                                    </button>
                                }
                                @if (Session.TienePermiso("Materias", "Baja"))
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarAsync(m)">
                                        Eliminar
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal de Modificación -->
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Modificar Materia</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(mensajeErrorModal))
                    {
                        <div class="alert alert-danger py-2 small">@mensajeErrorModal</div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Descripción *</label>
                        <input type="text" class="form-control" @bind="materiaActual.Descripcion" placeholder="Ej: Análisis Matemático I" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Horas Semanales *</label>
                            <input type="number" class="form-control" min="1" @bind="materiaActual.HsSemanales" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Horas Totales *</label>
                            <input type="number" class="form-control" min="1" @bind="materiaActual.HsTotales" />
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-bold">Plan de Estudio Asignado</label>
                        <input type="text" class="form-control bg-light" value="@ObtenerNombrePlan(materiaActual.IdPlan)" disabled />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-primary" @onclick="GuardarAsync">Guardar Cambios</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<MateriaDTO>? materias;
    private List<PlanDTO> planes = new();
    private MateriaDTO materiaActual = new();
    private string textoBusqueda = string.Empty;
    private bool cargando = true;
    private bool mostrarModal = false;
    private string? mensajeExito;
    private string? mensajeError;
    private string? mensajeErrorModal;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.EstaAutenticado || !Session.TienePermiso("Materias", "Consultar"))
        {
            Navigation.NavigateTo("/");
            return;
        }

        await CargarPlanesAsync();
        await CargarGrillaAsync();
    }

    private async Task CargarPlanesAsync()
    {
        try
        {
            var resultado = await Session.HttpClient.GetFromJsonAsync<IEnumerable<PlanDTO>>("planes");
            planes = resultado?.ToList() ?? new List<PlanDTO>();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar planes: {ex.Message}";
        }
    }

    private async Task CargarGrillaAsync()
    {
        try
        {
            cargando = true;
            mensajeError = null;

            var resultado = await Session.HttpClient.GetFromJsonAsync<IEnumerable<MateriaDTO>>("materias");
            materias = resultado?.ToList() ?? new List<MateriaDTO>();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al cargar materias: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task BuscarAsync()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            await CargarGrillaAsync();
            return;
        }

        try
        {
            cargando = true;
            string textoCodificado = Uri.EscapeDataString(textoBusqueda.Trim());
            var resultado = await Session.HttpClient.GetFromJsonAsync<IEnumerable<MateriaDTO>>($"materias/criteria?texto={textoCodificado}");
            materias = resultado?.ToList() ?? new List<MateriaDTO>();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error en la búsqueda: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ManejarTeclaBusqueda(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await BuscarAsync();
        }
    }

    private async Task MostrarTodosAsync()
    {
        textoBusqueda = string.Empty;
        await CargarGrillaAsync();
    }

    private string ObtenerNombrePlan(int idPlan)
    {
        var plan = planes.FirstOrDefault(p => p.Id == idPlan);
        return plan != null ? plan.Descripcion : $"Plan #{idPlan}";
    }

    private void AbrirModalModificar(MateriaDTO materia)
    {
        mensajeErrorModal = null;
        materiaActual = new MateriaDTO
        {
            Id = materia.Id,
            Descripcion = materia.Descripcion,
            HsSemanales = materia.HsSemanales,
            HsTotales = materia.HsTotales,
            IdPlan = materia.IdPlan
        };
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        mensajeErrorModal = null;
    }

    private async Task GuardarAsync()
    {
        mensajeErrorModal = null;

        if (string.IsNullOrWhiteSpace(materiaActual.Descripcion))
        {
            mensajeErrorModal = "La descripción es obligatoria.";
            return;
        }

        if (materiaActual.HsSemanales <= 0)
        {
            mensajeErrorModal = "Las horas semanales deben ser mayores que 0.";
            return;
        }

        if (materiaActual.HsTotales < materiaActual.HsSemanales)
        {
            mensajeErrorModal = "Las horas totales no pueden ser menores que las semanales.";
            return;
        }

        try
        {
            var response = await Session.HttpClient.PutAsJsonAsync("materias", materiaActual);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                mensajeErrorModal = $"No se pudo guardar: {error}";
                return;
            }

            mostrarModal = false;
            mensajeExito = "Materia modificada con éxito.";
            await CargarGrillaAsync();
        }
        catch (Exception ex)
        {
            mensajeErrorModal = $"Error al guardar: {ex.Message}";
        }
    }

    private async Task EliminarAsync(MateriaDTO materia)
    {
        bool confirma = await JS.InvokeAsync<bool>("confirm", 
            $"¿Confirma eliminar la materia \"{materia.Descripcion}\"?");

        if (!confirma) return;

        try
        {
            var response = await Session.HttpClient.DeleteAsync($"materias/{materia.Id}");

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                mensajeError = $"No se pudo eliminar: {error}";
                return;
            }

            mensajeExito = "Materia eliminada con éxito.";
            await CargarGrillaAsync();
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al eliminar: {ex.Message}";
        }
    }
}

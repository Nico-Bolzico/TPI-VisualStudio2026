@implements IDisposable
@inject APISession Session
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">TPI Academia</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <!-- Inicio siempre visible -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                Inicio
            </NavLink>
        </div>

        @if (Session.EstaAutenticado)
        {
            <!-- SECCIÓN: GESTIÓN -->
            <div class="px-3 pt-3 pb-1 text-uppercase text-white-50 fw-bold small">
                Gestión
            </div>

            @if (Session.TienePermiso("Personas", "Consultar"))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="personas">
                        Personas
                    </NavLink>
                </div>
            }

            @if (Session.TienePermiso("Materias", "Consultar"))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="materias">
                        Materias
                    </NavLink>
                </div>
            }

            @if (Session.TienePermiso("Planes", "Consultar"))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="planes">
                        Planes
                    </NavLink>
                </div>
            }

            @if (Session.TienePermiso("Comisiones", "Consultar"))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="comisiones">
                        Comisiones
                    </NavLink>
                </div>
            }

            @if (Session.TienePermiso("Cursos", "Consultar"))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="cursos">
                        Cursos
                    </NavLink>
                </div>
            }

            <!-- SECCIÓN: REPORTES -->
            @if (Session.TienePermiso("Cursos", "Consultar") || Session.TienePermiso("Planes", "Consultar"))
            {
                <div class="px-3 pt-3 pb-1 text-uppercase text-white-50 fw-bold small">
                    Reportes
                </div>

                @if (Session.TienePermiso("Cursos", "Consultar"))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="reporte-cursos">
                            Cursos / Cupos
                        </NavLink>
                    </div>
                }

                @if (Session.TienePermiso("Planes", "Consultar"))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="reporte-planes">
                            Planes y Horas
                        </NavLink>
                    </div>
                }
            }

            <!-- SECCIÓN: SESIÓN -->
            <div class="px-3 pt-3 pb-1 text-uppercase text-white-50 fw-bold small">
                Sesión
            </div>
            <div class="nav-item px-3 text-white small">
                <div class="text-white-50">Conectado:</div>
                <div class="fw-bold text-truncate">@Session.UsuarioActual?.NombreUsuario</div>
                @if (!string.IsNullOrEmpty(Session.UsuarioActual?.Nombre))
                {
                    <div class="text-white-50 text-truncate small">@Session.UsuarioActual?.Nombre @Session.UsuarioActual?.Apellido</div>
                }
                <button class="btn btn-outline-light btn-sm w-100 mt-2" @onclick="CerrarSesion">
                    Cerrar Sesión
                </button>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        // Suscribirse al evento para que el menú reaccione inmediatamente al iniciar o cerrar sesión
        Session.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Session.OnChange -= StateHasChanged;
    }

    private void CerrarSesion()
    {
        Session.CerrarSesion();
        Navigation.NavigateTo("/");
    }
}

@inherits LayoutComponentBase
@inject APISession Session

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <span class="text-secondary fw-semibold">Sistema de Gestión Académica - UTN FRRo</span>
            @if (Session.EstaAutenticado)
            {
                <span class="text-muted small">
                    Usuario: <strong class="text-dark">@Session.UsuarioActual?.NombreUsuario</strong>
                </span>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    Se produjo un error no controlado.
    <a href="" class="reload">Recargar</a>
    <a class="dismiss">x</a>
</div>
